{
  "name": "mm-plugin-hello",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Example MetaMask Agent Wallet (mm) CLI plugin",
  "license": "MIT",
  "author": "hieu-w",
  "homepage": "https://github.com/hieu-w/agent-wallet-plugin-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hieu-w/agent-wallet-plugin-template.git"
  },
  "bugs": {
    "url": "https://github.com/hieu-w/agent-wallet-plugin-template/issues"
  },
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet"
  ],
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc && oclif manifest",
    "clean": "rimraf dist oclif.manifest.json",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands"
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.1.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^6.1.5",
    "oclif": "^4.23.14",
    "typescript": "^5.9.3"
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.1.0",
    "capabilities": [],
    "commands": [
      {
        "id": "ping",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "demo:balance",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "balances",
          "accounts"
        ]
      },
      {
        "id": "demo:submit",
        "capabilities": [
          "wallet-submit"
        ],
        "dataAccess": []
      },
      {
        "id": "vault:mnemonic",
        "capabilities": [],
        "dataAccess": [
          "mnemonic"
        ]
      },
      {
        "id": "admin:config",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "admin:network",
        "capabilities": [
          "network-manage"
        ],
        "dataAccess": []
      }
    ]
  }
}
